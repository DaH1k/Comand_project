<UserControl x:Class="ChatClient.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#181824">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20" MinWidth="300">

            <!-- Заголовок сторінки -->
            <TextBlock Text="USER PROFILE"
           Foreground="#6C5CE7"
           FontSize="24"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0,10,0,30"/>

            <!-- Картка з даними користувача -->
            <Border Background="#222235" 
                    BorderBrush="#3F3F5F" 
                    BorderThickness="1" 
                    Padding="20" 
                    CornerRadius="8">

                <StackPanel>
                    <!-- Юзернейм із великою іконкою -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="👤 " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Username: " Foreground="#A0A0C0" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Danilo" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Лінія-розділювач всередині картки -->
                    <Border Height="1" Background="#3F3F5F" Margin="0,0,0,15"/>

                    <!-- Статус із гарним зеленим кольором -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟢 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Status: " Foreground="#A0A0C0" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Online" Foreground="#2ECC71" FontSize="15" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>
</UserControl>
