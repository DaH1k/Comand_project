<UserControl x:Class="ChatClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#181824">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20" MaxWidth="350">

            <!-- Заголовок сторінки -->
            <TextBlock Text="SETTINGS"
           Foreground="#6C5CE7"
           FontSize="24"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0,10,0,30"/>

            <!-- Підпис для випадаючого списку -->
            <TextBlock Text="Select App Theme" 
                       Foreground="#A0A0C0" 
                       FontSize="13" 
                       Margin="0,0,0,8"/>

            <!-- Стилізований ComboBox -->
            <ComboBox x:Name="ThemeComboBox" Background="#222235" Foreground="White" 
                      BorderBrush="#3F3F5F" BorderThickness="1"
                      Padding="10,6" FontSize="14" Margin="0,0,0,20">
                <ComboBoxItem Content="Dark" Background="#222235" Foreground="White" IsSelected="True"/>
                <ComboBoxItem Content="Light" Background="#222235" Foreground="White"/>
                <ComboBoxItem Content="Blue" Background="#222235" Foreground="White"/>
            </ComboBox>

            <!-- Кнопка застосування налаштувань -->
            <Button Content="Apply Theme"
                    Background="#6C5CE7" Foreground="White" BorderThickness="0"
                    Padding="0,12" FontSize="15" FontWeight="SemiBold"/>

        </StackPanel>
    </Grid>
</UserControl>
